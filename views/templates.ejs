<%- include('_head', { active: 'templates' }) %>

<h1 style="font:700 22px/1.2 Georgia,serif;color:var(--ink);margin:0 0 4px">Templates</h1>
<p style="color:var(--muted);margin:0 0 20px;font-size:14px;max-width:720px">
  Edit the reusable wording that every new quotation starts from. Saving a template updates the default for all
  <em>future</em> quotations — quotations already issued keep the exact wording frozen at the time they were created.
</p>

<div class="tabs">
  <a href="#presets" data-tab="presets" class="on">Standardized actions</a>
  <a href="#catalog" data-tab="catalog">Others agreed actions</a>
  <a href="#general" data-tab="general">General conditions</a>
</div>

<% if (error) { %>
  <div class="alert err"><svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1a9 9 0 100 18A9 9 0 0010 1zm0 4a1 1 0 011 1v4a1 1 0 11-2 0V6a1 1 0 011-1zm0 9.5a1.15 1.15 0 110-2.3 1.15 1.15 0 010 2.3z"/></svg><span><%= error %></span></div>
<% } %>
<% if (saved) { %>
  <div class="alert ok" id="savedBanner"><svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1a9 9 0 100 18A9 9 0 0010 1zm4.3 6.7l-5 5a1 1 0 01-1.4 0l-2.2-2.2a1 1 0 011.4-1.4l1.5 1.5 4.3-4.3a1 1 0 011.4 1.4z"/></svg><span>Template saved. It will apply to every new quotation from now on.</span></div>
<% } %>
<% if (reset) { %>
  <div class="alert info"><svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1a9 9 0 100 18A9 9 0 0010 1zm0 4.2a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4zM11.2 15h-2.4v-6h2.4z"/></svg><span>Restored to the shipped default wording.</span></div>
<% } %>

<!-- ============================ STANDARDIZED ACTIONS ============================ -->
<section class="tab-pane" data-pane="presets">
  <form class="card" method="post" action="/templates/presets" data-array="presets">
    <h2><span class="num">3</span> Overview of standardized analyze and action
      <span style="margin-left:auto"><%- status.presets.customized ? '<span class="badge custom">Customized</span>' : '<span class="badge default">Default</span>' %></span>
    </h2>
    <p class="lead">These presets appear in Step 3 of the quotation. Each preset has an intro line and an ordered list of actions (one per line). The chosen preset's wording prints on page 2.</p>

    <div id="presetList">
      <% presets.forEach(function(p, i){ %>
        <div class="editor-item" data-repeat>
          <div class="ei-head">
            <span class="idx">Preset <%= i + 1 %></span>
            <span class="grow"></span>
            <button type="button" class="icon-btn remove" title="Remove preset" aria-label="Remove preset">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
            </button>
          </div>
          <label>Preset name</label>
          <input type="text" data-name="label" value="<%= p.label %>" placeholder="e.g. M/T Spindle — Standard Recondition">
          <label>Intro line</label>
          <input type="text" data-name="intro" value="<%= p.intro %>">
          <label>Actions (one per line, printed in order)</label>
          <textarea data-name="items" rows="7"><%= p.items.join('\n') %></textarea>
        </div>
      <% }) %>
    </div>

    <button type="button" class="btn ghost sm add-row" data-add="preset">+ Add preset</button>

    <div class="actions">
      <button type="submit" class="primary">Save presets</button>
      <button type="button" class="btn danger reset" data-kind="presets">Reset to default</button>
    </div>
  </form>
</section>

<!-- ============================ OTHERS AGREED ACTIONS ============================ -->
<section class="tab-pane" data-pane="catalog" hidden>
  <form class="card" method="post" action="/templates/catalog" data-array="catalog">
    <h2>Others agreed actions
      <span style="margin-left:auto"><%- status.catalog.customized ? '<span class="badge custom">Customized</span>' : '<span class="badge default">Default</span>' %></span>
    </h2>
    <p class="lead">The tick-list shown on the quotation. Set which actions are ticked by default when a new quotation opens — that can still be changed per quotation.</p>

    <div id="catalogList">
      <% catalog.forEach(function(a){ %>
        <div class="catalog-row" data-repeat>
          <input type="text" data-name="label" value="<%= a.label %>" placeholder="Action name">
          <label class="toggle" style="margin:0"><input type="checkbox" data-name="defaultOn" <%= a.defaultOn ? 'checked' : '' %>> Ticked by default</label>
          <button type="button" class="icon-btn remove" title="Remove" aria-label="Remove action">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
          </button>
        </div>
      <% }) %>
    </div>

    <button type="button" class="btn ghost sm add-row" data-add="catalog">+ Add action</button>

    <div class="actions">
      <button type="submit" class="primary">Save agreed actions</button>
      <button type="button" class="btn danger reset" data-kind="catalog">Reset to default</button>
    </div>
  </form>
</section>

<!-- ============================ GENERAL CONDITIONS ============================ -->
<section class="tab-pane" data-pane="general" hidden>
  <form class="card" method="post" action="/templates/general" data-array="general[clauses]">
    <h2>ORRNA JAYA General Condition — Repair &amp; refurbishment work
      <span style="margin-left:auto"><%- status.general.customized ? '<span class="badge custom">Customized</span>' : '<span class="badge default">Default</span>' %></span>
    </h2>
    <p class="lead">The full terms printed on the closing pages. <code>{{warrantyMonthsWord}}</code> inside clause 10.1 is replaced with each quotation's warranty figure.</p>

    <div class="grid">
      <div><label>Version</label><input type="text" name="general[version]" value="<%= generalConditions.version %>"></div>
      <div><label>Effective from</label><input type="text" name="general[effectiveFrom]" value="<%= generalConditions.effectiveFrom %>"></div>
      <div></div>
    </div>
    <label>Heading</label>
    <input type="text" name="general[title]" value="<%= generalConditions.title %>">

    <label style="margin-top:16px">Clauses</label>
    <div id="clauseList">
      <% generalConditions.clauses.forEach(function(cl, i){ %>
        <div class="editor-item" data-repeat>
          <div class="ei-head">
            <span class="idx">Clause <%= i + 1 %></span>
            <span class="grow"></span>
            <button type="button" class="icon-btn remove" title="Remove clause" aria-label="Remove clause">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
            </button>
          </div>
          <input type="text" data-name="h" value="<%= cl.h %>" placeholder="Clause heading">
          <textarea data-name="p" rows="4" placeholder="One paragraph per line"><%= cl.p.join('\n') %></textarea>
        </div>
      <% }) %>
    </div>
    <button type="button" class="btn ghost sm add-row" data-add="clause">+ Add clause</button>

    <label style="margin-top:16px">Closing line</label>
    <textarea name="general[closing]" rows="2"><%= generalConditions.closing %></textarea>

    <div class="actions">
      <button type="submit" class="primary">Save general conditions</button>
      <button type="button" class="btn danger reset" data-kind="general">Reset to default</button>
    </div>
  </form>
</section>

<!-- reset forms (submitted programmatically) -->
<form id="resetForm" method="post" action="/templates/reset" style="display:none">
  <input type="hidden" name="kind" id="resetKind">
</form>

<!-- clone templates -->
<template id="tpl-preset">
  <div class="editor-item" data-repeat>
    <div class="ei-head"><span class="idx">New preset</span><span class="grow"></span>
      <button type="button" class="icon-btn remove" title="Remove preset" aria-label="Remove preset"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></button></div>
    <label>Preset name</label><input type="text" data-name="label" placeholder="Preset name">
    <label>Intro line</label><input type="text" data-name="intro">
    <label>Actions (one per line, printed in order)</label><textarea data-name="items" rows="7"></textarea>
  </div>
</template>
<template id="tpl-catalog">
  <div class="catalog-row" data-repeat>
    <input type="text" data-name="label" placeholder="Action name">
    <label class="toggle" style="margin:0"><input type="checkbox" data-name="defaultOn"> Ticked by default</label>
    <button type="button" class="icon-btn remove" title="Remove" aria-label="Remove action"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
  </div>
</template>
<template id="tpl-clause">
  <div class="editor-item" data-repeat>
    <div class="ei-head"><span class="idx">New clause</span><span class="grow"></span>
      <button type="button" class="icon-btn remove" title="Remove clause" aria-label="Remove clause"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></button></div>
    <input type="text" data-name="h" placeholder="Clause heading">
    <textarea data-name="p" rows="4" placeholder="One paragraph per line"></textarea>
  </div>
</template>

<script>
(function () {
  // ---- tabs ----
  var tabs = Array.prototype.slice.call(document.querySelectorAll('.tabs a'));
  var panes = Array.prototype.slice.call(document.querySelectorAll('.tab-pane'));
  function showTab(name) {
    tabs.forEach(function (t) { t.classList.toggle('on', t.dataset.tab === name); });
    panes.forEach(function (p) { p.hidden = p.dataset.pane !== name; });
  }
  tabs.forEach(function (t) {
    t.addEventListener('click', function (e) { e.preventDefault(); showTab(t.dataset.tab); history.replaceState(null, '', '#' + t.dataset.tab); });
  });
  var initial = (location.hash || '').replace('#', '');
  showTab(['presets', 'catalog', 'general'].indexOf(initial) !== -1 ? initial : 'presets');

  // ---- add / remove repeatable rows ----
  var adders = { preset: 'tpl-preset', catalog: 'tpl-catalog', clause: 'tpl-clause' };
  var lists = { preset: 'presetList', catalog: 'catalogList', clause: 'clauseList' };
  document.addEventListener('click', function (e) {
    var add = e.target.closest && e.target.closest('[data-add]');
    if (add) {
      var kind = add.dataset.add;
      var tpl = document.getElementById(adders[kind]);
      var list = document.getElementById(lists[kind]);
      var node = tpl.content.firstElementChild.cloneNode(true);
      list.appendChild(node);
      var first = node.querySelector('input,textarea');
      if (first) first.focus();
      return;
    }
    var rm = e.target.closest && e.target.closest('.remove');
    if (rm) {
      var row = rm.closest('[data-repeat]');
      if (row) row.parentNode.removeChild(row);
      return;
    }
    var reset = e.target.closest && e.target.closest('.reset');
    if (reset) {
      if (!window.confirm('Discard the saved template and restore the shipped default wording?')) return;
      document.getElementById('resetKind').value = reset.dataset.kind;
      document.getElementById('resetForm').submit();
    }
  });

  // ---- reindex names on submit so arrays post cleanly ----
  Array.prototype.forEach.call(document.querySelectorAll('form[data-array]'), function (form) {
    form.addEventListener('submit', function () {
      var prefix = form.dataset.array;
      var rows = form.querySelectorAll('[data-repeat]');
      Array.prototype.forEach.call(rows, function (row, i) {
        Array.prototype.forEach.call(row.querySelectorAll('[data-name]'), function (el) {
          el.name = prefix + '[' + i + '][' + el.dataset.name + ']';
        });
      });
    });
  });

  // auto-hide the saved banner after a moment
  var banner = document.getElementById('savedBanner');
  if (banner) setTimeout(function () { banner.style.transition = 'opacity .4s'; banner.style.opacity = '0'; }, 4000);
})();
</script>
</main></body></html>
