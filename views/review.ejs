<%- include('_head') %>
<% (q.warnings || []).forEach(function(w){ %>
  <div class="warn"><strong>Check this:</strong> <%= w %></div>
<% }) %>
<form method="post" action="/generate" id="reviewForm">

  <div class="card">
    <h2>Step 2 — Confirm what was read from page 1</h2>
    <div class="grid">
      <div><label>Quote no</label><input type="text" name="quoteNo" value="<%= q.quoteNo %>"></div>
      <div><label>Job no</label><input type="text" name="jobNo" value="<%= q.jobNo %>"></div>
      <div><label>Date</label><input type="text" name="date" value="<%= q.date %>"></div>
    </div>
    <div class="grid2">
      <div><label>Attention</label><input type="text" name="attention" value="<%= q.attention %>"></div>
      <div><label>Customer name</label><input type="text" name="customerName" value="<%= q.customer.name %>"></div>
    </div>
    <label>Customer address (one line per row)</label>
    <textarea name="customerAddress"><%= q.customer.addressLines.join('\n') %></textarea>
    <div class="hint">Only this address is printed. Anything else found on the page is flagged above, never copied.</div>
  </div>

  <div class="card">
    <h2>Cost lines</h2>
    <% q.costBox.rows.forEach(function(r){ %>
      <div class="rowline">
        <input type="text" name="rowLabel" value="<%= r.label %>">
        <input type="text" name="rowValue" value="<%= r.value || '' %>">
        <select name="rowMode">
          <option value="inline" <%= r.mode === 'inline' ? 'selected' : '' %>>Inline</option>
          <option value="columns" <%= r.mode === 'columns' ? 'selected' : '' %>>Columns</option>
        </select>
      </div>
    <% }) %>
    <div class="rowline">
      <input type="text" name="rowLabel" placeholder="Add a line…">
      <input type="text" name="rowValue" placeholder="Value">
      <select name="rowMode"><option value="inline">Inline</option><option value="columns">Columns</option></select>
    </div>
    <label>Warranty (months) — also sets clause 10.1</label>
    <input type="number" name="warrantyMonths" min="1" max="36" value="<%= q.warrantyMonths %>" style="max-width:160px">
    <div class="hint">Page 1 and the warranty clause are driven by this one field, so they cannot disagree.</div>
  </div>

  <div class="card">
    <h2>Step 3 — Overview of standardized analyze and action</h2>
    <label>Preset</label>
    <select name="presetKey" id="presetKey">
      <% presets.forEach(function(p){ %>
        <option value="<%= p.key %>" <%= p.key === q.standardActionsPresetKey ? 'selected' : '' %>>
          <%= p.label %> (<%= p.items.length %> items)
        </option>
      <% }) %>
    </select>
    <p style="margin:10px 0 0"><a href="#" id="presetToggle" style="font-size:13px">Show what this preset prints</a></p>
    <% presets.forEach(function(p){ %>
      <div class="preset-detail" data-preset="<%= p.key %>">
        <p><%= p.intro %></p>
        <ol>
          <% p.items.forEach(function(it){ %><li><%= it %></li><% }) %>
        </ol>
      </div>
    <% }) %>
    <div class="hint">Wording is fixed by the preset. To change it, edit the clause library rather than the quotation.</div>
  </div>

  <div class="card">
    <h2>Others agreed actions</h2>
    <div class="ticks">
      <% catalog.forEach(function(a){ %>
        <label class="tick" style="font-weight:400;text-transform:none">
          <input type="checkbox" name="tick_<%= a.key %>" <%= q.agreedActions[a.key] ? 'checked' : '' %>>
          <span><%= a.label %></span>
        </label>
      <% }) %>
    </div>
  </div>

  <div class="card">
    <h2>Conditions</h2>
    <div class="grid">
      <div><label>Validity (days)</label><input type="number" name="validityDays" value="<%= q.conditions.validityDays %>"></div>
      <div><label>Payment terms (days)</label><input type="number" name="paymentTermsDays" value="<%= q.conditions.paymentTermsDays %>"></div>
      <div><label>Delivery (days)</label><input type="number" name="deliveryDays" value="<%= q.conditions.deliveryDays %>"></div>
    </div>
    <label>Other conditions</label>
    <input type="text" name="otherConditions" value="<%= q.conditions.otherConditions %>">
    <div class="hint">The full wording of those general conditions is in Step 4 below, where it can be read and amended.</div>
  </div>

  <div class="card">
    <h2>Step 4 — General conditions, repair &amp; refurbishment work</h2>
    <p style="margin:0;color:#556;font-size:14px">Library version <%= generalConditions.version %>, effective <%= generalConditions.effectiveFrom %>. These clauses print on the final pages. Edit them only for this quotation; the wording you leave here is frozen onto the record.</p>
    <p style="margin:10px 0 0"><a href="#" id="gcToggle" style="font-size:13px">Show the full wording</a></p>

    <div id="gcPanel" class="gc-panel">
      <label>Heading</label>
      <input type="text" name="gcTitle" value="<%= generalConditions.title %>">

      <% generalConditions.clauses.forEach(function(cl, i){ %>
        <div class="gc-clause">
          <label>Clause <%= i + 1 %></label>
          <input type="text" name="gcHeading" value="<%= cl.h %>">
          <textarea name="gcBody" class="gc-body" rows="3"><%= cl.p.join('\n') %></textarea>
        </div>
      <% }) %>

      <label>Closing line</label>
      <textarea name="gcClosing" class="gc-body" rows="2"><%= generalConditions.closing %></textarea>

      <div class="hint">One paragraph per line. <code>{{warrantyMonthsWord}}</code> in clause 10.1 is replaced with the warranty set in Step 2, so the two can never disagree. Any change marks the terms version as edited on the issued record.</div>
      <p style="margin:12px 0 0"><a href="#" id="gcReset" style="font-size:13px">Reset to library wording</a></p>
    </div>
  </div>

  <script id="gcLibrary" type="application/json"><%- JSON.stringify(generalConditions).replace(/</g, '\\u003c') %></script>

  <p><button type="submit" id="generateBtn">Generate quotation PDF</button>
  <a href="/" style="margin-left:16px;font-size:13px">Start over</a></p>
  <div class="busy" id="generateBusy"><span class="spinner"></span><span>Assembling pages 2 to 6…</span></div>
</form>
<script>
(function () {
  var sel = document.getElementById('presetKey');
  var toggle = document.getElementById('presetToggle');
  var panels = Array.prototype.slice.call(document.querySelectorAll('.preset-detail'));
  var open = false;

  function sync() {
    panels.forEach(function (el) {
      el.classList.toggle('on', open && el.dataset.preset === sel.value);
    });
    toggle.textContent = open ? 'Hide preset contents' : 'Show what this preset prints';
  }
  toggle.addEventListener('click', function (e) { e.preventDefault(); open = !open; sync(); });
  sel.addEventListener('change', sync);
  sync();

  var gcToggle = document.getElementById('gcToggle');
  var gcPanel = document.getElementById('gcPanel');
  var library = JSON.parse(document.getElementById('gcLibrary').textContent);

  function autosize(el) {
    el.style.height = 'auto';
    el.style.height = (el.scrollHeight + 2) + 'px';
  }
  function autosizeAll() {
    Array.prototype.forEach.call(gcPanel.querySelectorAll('.gc-body'), autosize);
  }
  gcPanel.addEventListener('input', function (e) {
    if (e.target.classList.contains('gc-body')) autosize(e.target);
  });
  gcToggle.addEventListener('click', function (e) {
    e.preventDefault();
    var on = gcPanel.classList.toggle('on');
    gcToggle.textContent = on ? 'Hide the full wording' : 'Show the full wording';
    if (on) autosizeAll();
  });
  document.getElementById('gcReset').addEventListener('click', function (e) {
    e.preventDefault();
    if (!window.confirm('Discard your edits and restore the library wording?')) return;
    gcPanel.querySelector('[name=gcTitle]').value = library.title;
    gcPanel.querySelector('[name=gcClosing]').value = library.closing;
    var heads = gcPanel.querySelectorAll('[name=gcHeading]');
    var bodies = gcPanel.querySelectorAll('[name=gcBody]');
    library.clauses.forEach(function (cl, i) {
      if (heads[i]) heads[i].value = cl.h;
      if (bodies[i]) bodies[i].value = cl.p.join('\n');
    });
    autosizeAll();
  });

  var form = document.getElementById('reviewForm');
  var btn = document.getElementById('generateBtn');
  var busy = document.getElementById('generateBusy');
  form.addEventListener('submit', function () {
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner"></span>Generating…';
    busy.classList.add('on');
  });
  window.addEventListener('pageshow', function () {
    btn.disabled = false;
    btn.textContent = 'Generate quotation PDF';
    busy.classList.remove('on');
  });
})();
</script>
</main></body></html>
