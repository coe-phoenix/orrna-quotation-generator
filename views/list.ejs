<%- include('_head', { active: 'list' }) %>
<div class="card">
  <h2>Issued quotations</h2>
  <p class="lead">Reprints replay the exact values and terms frozen at issue time.</p>
  <% if (!rows.length) { %>
    <div class="alert info"><svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1a9 9 0 100 18A9 9 0 0010 1zm0 4.2a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4zM11.2 15h-2.4v-6h2.4z"/></svg><span>Nothing issued yet. <a href="/">Create your first quotation →</a></span></div>
  <% } else { %>
    <div style="overflow-x:auto">
    <table>
      <thead><tr><th>Quote no</th><th>Job no</th><th>Customer</th><th>Issued</th><th>Terms</th><th></th></tr></thead>
      <tbody>
      <% rows.forEach(function(r){ %>
        <tr>
          <td><strong><%= r.quote_no || '—' %></strong></td>
          <td><%= r.job_no || '—' %></td>
          <td><%= r.customer_name || '—' %></td>
          <td><%= new Date(r.issued_at).toLocaleString('en-GB') %></td>
          <td>
            <%= r.boilerplate_version %>
            <% if (String(r.boilerplate_version).indexOf('edited') !== -1) { %><span class="badge custom">edited</span><% } %>
          </td>
          <td><a class="btn ghost sm" href="/quotation/<%= r.id %>.pdf" target="_blank" rel="noopener">Reprint</a></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
    </div>
  <% } %>
  <div class="actions"><a class="btn ghost" href="/">← New quotation</a></div>
</div>
</main></body></html>
