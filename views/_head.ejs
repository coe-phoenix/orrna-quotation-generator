<!doctype html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>ORRNA JAYA — Quotation Generator</title>
<style>
:root{--ink:#17365D;--accent:#4F81BD;--line:#d8dee6;--bg:#f6f7f9}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:#1a1a1a;font:15px/1.55 -apple-system,Segoe UI,Roboto,sans-serif}
header{background:#fff;border-bottom:3px solid var(--accent);padding:18px 24px}
header h1{margin:0;font:600 19px/1.2 Georgia,serif;color:var(--ink);letter-spacing:.3px}
header p{margin:4px 0 0;color:#667;font-size:13px}
main{max-width:960px;margin:24px auto;padding:0 20px 60px}
.card{background:#fff;border:1px solid var(--line);border-radius:8px;padding:22px;margin-bottom:18px}
.card h2{margin:0 0 14px;font-size:14px;text-transform:uppercase;letter-spacing:.8px;color:var(--ink)}
label{display:block;font-size:12px;font-weight:600;color:#556;margin:10px 0 4px}
input[type=text],input[type=number],textarea,select{width:100%;padding:8px 10px;border:1px solid var(--line);border-radius:5px;font:inherit;background:#fff}
textarea{min-height:88px;resize:vertical}
.grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px}
button{background:var(--ink);color:#fff;border:0;border-radius:6px;padding:11px 20px;font:600 14px/1 inherit;cursor:pointer}
.ticks{columns:2;column-gap:28px}
.tick{display:flex;gap:8px;align-items:flex-start;padding:5px 0;break-inside:avoid;font-size:13px}
.tick input{margin-top:3px}
table{width:100%;border-collapse:collapse;font-size:13px}
th,td{text-align:left;padding:8px 6px;border-bottom:1px solid var(--line)}
th{font-size:11px;text-transform:uppercase;letter-spacing:.6px;color:#778}
.err{background:#fdecea;border:1px solid #f5c2bd;color:#8d2b20;padding:12px 14px;border-radius:6px;margin-bottom:16px;font-size:14px}
.warn{background:#fff8e1;border:1px solid #f0dca0;color:#7a5d05;padding:12px 14px;border-radius:6px;margin-bottom:16px;font-size:14px}
.hint{font-size:12px;color:#778;margin-top:6px}
.rowline{display:grid;grid-template-columns:1.4fr 1.4fr 110px;gap:10px;margin-bottom:8px}
a{color:var(--ink)}
button[disabled]{opacity:.75;cursor:progress}
.spinner{display:inline-block;width:14px;height:14px;margin-right:8px;vertical-align:-2px;border:2px solid rgba(255,255,255,.35);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.busy{display:none;align-items:center;gap:10px;margin-top:14px;font-size:13px;color:#556}
.busy.on{display:flex}
.busy .spinner{border-color:rgba(23,54,93,.25);border-top-color:var(--ink)}
.preset-detail{display:none;margin-top:12px;border:1px solid var(--line);border-radius:6px;padding:14px 16px;background:#fbfcfd}
.preset-detail.on{display:block}
.preset-detail p{margin:0 0 10px;font-size:13px;color:#556}
.preset-detail ol{margin:0;padding-left:20px;font-size:13px;color:#243}
.preset-detail li{margin-bottom:5px}
.actions{display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin-top:16px}
.btn-link{display:inline-block;background:var(--ink);color:#fff;text-decoration:none;border-radius:6px;padding:11px 20px;font:600 14px/1 inherit}
.btn-link.ghost{background:#fff;color:var(--ink);border:1px solid var(--line)}
.gc-panel{display:none;margin-top:14px;border-top:1px solid var(--line);padding-top:6px}
.gc-panel.on{display:block}
.gc-clause{border-top:1px dashed var(--line);margin-top:14px;padding-top:10px}
.gc-clause label{color:var(--accent)}
.gc-body{min-height:0;overflow:hidden;font-size:13px;line-height:1.5}
code{background:#eef1f5;border-radius:3px;padding:1px 4px;font-size:11px}
.ok{background:#eaf6ec;border:1px solid #b7ddbe;color:#20603a;padding:12px 14px;border-radius:6px;margin-bottom:16px;font-size:14px}
</style></head><body>
<header><h1>ORRNA JAYA ENGINEERING &amp; TRADING</h1><p>Quotation Generator — pages 2 to 6 assembled from the approved clause library</p></header><main>
