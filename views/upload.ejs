<%- include('_head', { active: 'upload' }) %>
<div class="steps">
  <span class="st on"><span class="dot">1</span> Upload</span><span class="bar"></span>
  <span class="st"><span class="dot">2</span> Review</span><span class="bar"></span>
  <span class="st"><span class="dot">3</span> Issue</span>
</div>

<% if (error) { %>
  <div class="alert err"><svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1a9 9 0 100 18A9 9 0 0010 1zm0 4a1 1 0 011 1v4a1 1 0 11-2 0V6a1 1 0 011-1zm0 9.5a1.15 1.15 0 110-2.3 1.15 1.15 0 010 2.3z"/></svg><span><%= error %></span></div>
<% } %>

<form class="card" id="uploadForm" method="post" action="/extract" enctype="multipart/form-data">
  <h2><span class="num">1</span> Upload the generated page 1</h2>
  <p class="lead">Upload the single-page quotation PDF produced by your existing system. Its values are transcribed by AI, then you review everything before the full document is issued.</p>

  <label for="pdf">Quotation PDF</label>
  <div id="drop" class="dropzone">
    <input type="file" id="pdf" name="pdf" accept="application/pdf" required>
    <div class="dz-face">
      <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V4M7 9l5-5 5 5"/><path d="M20 16v3a2 2 0 01-2 2H6a2 2 0 01-2-2v-3"/></svg>
      <div class="dz-text"><strong>Choose a PDF</strong> or drag it here</div>
      <div class="dz-name" id="dzName"></div>
    </div>
  </div>
  <div class="hint">PDF only, up to 15 MB. Nothing is written into the document that you have not confirmed on the next screen.</div>

  <div class="actions">
    <button type="submit" class="primary" id="readBtn"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6"/></svg> Read page 1</button>
    <a class="btn ghost" href="/preview.pdf" target="_blank" rel="noopener">Blank layout preview</a>
    <a class="btn link" href="/templates" style="margin-left:auto">Manage templates →</a>
  </div>
  <div class="busy" id="uploadBusy"><span class="spinner"></span><span>Reading page 1 and transcribing values — this usually takes 10–30 seconds.</span></div>
</form>

<style>
.dropzone{position:relative;border:1.5px dashed var(--line);border-radius:12px;background:#fafcff;transition:border-color .12s,background .12s}
.dropzone.drag,.dropzone:hover{border-color:var(--accent);background:#f2f7fd}
.dropzone input[type=file]{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:pointer}
.dz-face{display:flex;flex-direction:column;align-items:center;gap:8px;padding:30px 18px;color:var(--muted);text-align:center;pointer-events:none}
.dz-face svg{color:var(--accent)}
.dz-text strong{color:var(--ink)}
.dz-name{font-size:13px;font-weight:600;color:var(--ink-2);min-height:0}
</style>
<script>
(function () {
  var form = document.getElementById('uploadForm');
  var btn = document.getElementById('readBtn');
  var busy = document.getElementById('uploadBusy');
  var input = document.getElementById('pdf');
  var drop = document.getElementById('drop');
  var name = document.getElementById('dzName');

  input.addEventListener('change', function () {
    name.textContent = input.files && input.files[0] ? input.files[0].name : '';
  });
  ['dragenter','dragover'].forEach(function (e) {
    drop.addEventListener(e, function (ev) { ev.preventDefault(); drop.classList.add('drag'); });
  });
  ['dragleave','drop'].forEach(function (e) {
    drop.addEventListener(e, function (ev) { ev.preventDefault(); drop.classList.remove('drag'); });
  });

  form.addEventListener('submit', function () {
    if (!form.checkValidity()) return;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner"></span> Reading…';
    busy.classList.add('on');
  });
  window.addEventListener('pageshow', function () {
    btn.disabled = false;
    btn.textContent = 'Read page 1';
    busy.classList.remove('on');
  });
})();
</script>
</main></body></html>
