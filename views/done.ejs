<%- include('_head', { active: 'upload' }) %>
<div class="steps">
  <span class="st done"><span class="dot">✓</span> Upload</span><span class="bar"></span>
  <span class="st done"><span class="dot">✓</span> Review</span><span class="bar"></span>
  <span class="st done"><span class="dot">✓</span> Issue</span>
</div>

<div class="alert ok"><svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1a9 9 0 100 18A9 9 0 0010 1zm4.3 6.7l-5 5a1 1 0 01-1.4 0l-2.2-2.2a1 1 0 011.4-1.4l1.5 1.5 4.3-4.3a1 1 0 011.4 1.4z"/></svg><span><strong>Quotation issued.</strong> Values and terms are now frozen against this record.</span></div>

<div class="card">
  <h2>Quotation ready</h2>
  <table>
    <tr><th>Quote no</th><td><%= q.quoteNo || '—' %></td></tr>
    <tr><th>Job no</th><td><%= q.jobNo || '—' %></td></tr>
    <tr><th>Customer</th><td><%= q.customer.name || '—' %></td></tr>
    <tr><th>Terms version</th><td><%= q.boilerplateVersion %></td></tr>
    <% if (String(q.boilerplateVersion).indexOf('edited') !== -1) { %>
      <tr><th>Note</th><td>The general conditions were amended by hand on this quotation.</td></tr>
    <% } %>
  </table>
  <div class="actions">
    <a class="btn primary" href="/quotation/<%= id %>.pdf?download=1"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12M7 10l5 5 5-5"/><path d="M5 21h14"/></svg> Download PDF</a>
    <a class="btn ghost" href="/quotation/<%= id %>.pdf" target="_blank" rel="noopener">Open in new tab</a>
    <a class="btn ghost" href="/">Start a new quotation</a>
    <a class="btn ghost" href="/quotations">Issued quotations</a>
  </div>
  <div class="hint">The document can be reprinted at any time from the issued quotations list.</div>
</div>
</main></body></html>
