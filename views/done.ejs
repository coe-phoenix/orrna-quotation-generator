<%- include('_head') %>
<div class="ok"><strong>Quotation issued.</strong> Values and terms are now frozen against this record.</div>
<div class="card">
  <h2>Step 4 — Quotation ready</h2>
  <table>
    <tr><th>Quote no</th><td><%= q.quoteNo || '—' %></td></tr>
    <tr><th>Job no</th><td><%= q.jobNo || '—' %></td></tr>
    <tr><th>Customer</th><td><%= q.customer.name || '—' %></td></tr>
    <tr><th>Terms version</th><td><%= q.boilerplateVersion %></td></tr>
  </table>
  <div class="actions">
    <a class="btn-link" href="/quotation/<%= id %>.pdf?download=1">Download PDF</a>
    <a class="btn-link ghost" href="/quotation/<%= id %>.pdf" target="_blank" rel="noopener">Open in new tab</a>
    <a class="btn-link ghost" href="/">Start a new quotation</a>
    <a class="btn-link ghost" href="/quotations">Issued quotations</a>
  </div>
  <div class="hint">The document can be reprinted at any time from the issued quotations list.</div>
</div>
</main></body></html>
